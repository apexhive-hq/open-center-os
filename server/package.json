{
  "name": "open-center-os",
  "version": "2.2.0",
  "description": "Open-source MIT multi-branch operations server for education centers and SME service studios using Node 24 built-in node:sqlite, cookie/Bearer auth, bilingual POS invoicing, and deterministic SVG QR passes.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "open-center-os": "./dist/src/cli.js"
  },
  "main": "./dist/src/app.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/tests/*.test.js",
    "start": "node dist/src/cli.js"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
